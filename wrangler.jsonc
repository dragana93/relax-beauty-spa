{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "relax-beauty-spa",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // postgres.js (the Supabase connection) needs Node.js APIs and TCP sockets.
  "compatibility_flags": ["nodejs_compat"],
  // Keep the variables set in the Cloudflare dashboard (MAIL_FROM, OWNER_EMAIL, GOOGLE_*) when
  // a new version is deployed. Without this, every deploy would delete them.
  "keep_vars": true,
  "assets": {
    "directory": "dist/relax-beauty-spa/browser",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Every 15 minutes: retry emails and Google Calendar/Sheets copies that failed, and from 21:00
  // (studio time) send the owner the list of the next day's bookings.
  "triggers": { "crons": ["*/15 * * * *"] },
  // No settings or secrets are stored here. Locally they are in .dev.vars (see
  // .dev.vars.example); in production they are Worker variables and secrets in the Cloudflare
  // dashboard. See docs/SETUP.md.
  "observability": { "enabled": true }
}
