{
  "name": "relax-beauty-spa",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n api,web \"npm:start:api\" \"npm:start:web\"",
    "start:api": "node scripts/ensure-assets-dir.mjs && npm run db:migrate && wrangler dev --port 8787",
    "start:web": "ng serve",
    "build": "ng build && node scripts/postbuild.mjs",
    "preview": "npm run build && npm run db:migrate && wrangler dev --port 8787",
    "db:migrate": "wrangler d1 migrations apply relax-beauty-spa --local",
    "db:bookings": "wrangler d1 execute relax-beauty-spa --local --file scripts/bookings.sql",
    "db:clear": "wrangler d1 execute relax-beauty-spa --local --file scripts/clear-bookings.sql",
    "db:reset":"node scripts/reset-local-db.mjs && npm run db:migrate",
    "test": "vitest run -c vitest.server.config.mts",
    "typecheck": "tsc -p worker/tsconfig.json",
    "brand": "node scripts/generate-brand.mjs",
    "deploy": "npm test && npm run typecheck && npm run build && wrangler d1 migrations apply relax-beauty-spa --remote && wrangler deploy"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/ssr": "^22.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "hono": "^4.13.22",
    "jose": "^6.2.18",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@fontsource/allura": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/marcellus": "^5.3.0",
    "@types/node": "^22.12.0",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.168.0"
  }
}
