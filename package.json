{
  "name": "relax-beauty-spa",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n db,api,web \"npm:start:db\" \"npm:start:api\" \"npm:start:web\"",
    "start:db": "node scripts/local-db.mjs",
    "start:api": "node scripts/ensure-assets-dir.mjs && node scripts/start-api.mjs",
    "start:web": "ng serve",
    "build": "ng build && node scripts/postbuild.mjs",
    "preview": "npm run build && concurrently -k -n db,api \"npm:start:db\" \"npm:start:api\"",
    "db:push": "node scripts/db-push.mjs",
    "db:bookings": "node scripts/db-bookings.mjs",
    "db:reset": "node scripts/reset-local-db.mjs",
    "google:setup": "node scripts/google-setup.mjs",
    "test": "vitest run -c vitest.server.config.mts",
    "typecheck": "tsc -p worker/tsconfig.json",
    "brand": "node scripts/generate-brand.mjs",
    "ci": "npm run typecheck && npm test && npm run build",
    "deploy:ci": "node scripts/db-push.mjs && wrangler deploy",
    "deploy": "npm run ci && npm run deploy:ci"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-server": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/ssr": "^22.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/jost": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "hono": "^4.13.22",
    "jose": "^6.2.18",
    "postgres": "^3.4.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@cloudflare/workers-types": "^5.20261125.1",
    "@electric-sql/pglite": "^0.6.0",
    "@electric-sql/pglite-socket": "^0.3.0",
    "@fontsource/allura": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/marcellus": "^5.3.0",
    "@types/node": "^22.12.0",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "supabase": "^3.4.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.168.0"
  }
}
